# Secumator Configuration v2.0

# Core
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://secumator:secumator@localhost:5432/secumator
REDIS_URL=redis://localhost:6379/0

# AI Configuration (at least one required for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# Scanner Paths
NUCLEI_PATH=/usr/bin/nuclei
NMAP_PATH=/usr/bin/nmap
NIKTO_PATH=/usr/bin/nikto

# Scanning
SCAN_TIMEOUT=3600
MAX_CONCURRENT_SCANS=5
SCAN_RATE_LIMIT_PER_MINUTE=30

# Target Validation
ALLOW_PRIVATE_TARGETS=false
ALLOW_LOCALHOST_TARGETS=false

# Webhook Notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
NOTIFY_ON_SCAN_COMPLETE=true
NOTIFY_ON_CRITICAL_FINDING=true

# CVE Lookup (optional, increases NVD rate limits)
NVD_API_KEY=

# Output
REPORT_OUTPUT_DIR=/var/lib/secumator/reports
